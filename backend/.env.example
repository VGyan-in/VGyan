# Copy to .env for local development. In production set these as platform secrets.
ENV=development
DATABASE_URL=postgresql+psycopg://vgyan:vgyan@localhost:5433/vgyan
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-000000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8000

# local (dev) | s3 (required in production; private bucket: AWS S3, Cloudflare R2, Backblaze B2...)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# Gemini (server-side only; never ship in the app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# gemini | google_vision | none
OCR_PROVIDER=gemini
GOOGLE_VISION_API_KEY=

CONSENT_VERSION=1.0
ALLOW_STUDENT_REGISTRATION=true
