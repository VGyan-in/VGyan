# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app; never put secrets here.

# Research backend base URL. Leave empty until the server exists: data stays on the phone and sync waits.
EXPO_PUBLIC_API_BASE_URL=

# Must match the consent text version shown in the app. Changing it asks every student for consent again.
EXPO_PUBLIC_CONSENT_VERSION=1.0

# Automatic upload retries before an item waits for a manual retry.
EXPO_PUBLIC_SYNC_MAX_RETRIES=8

# Delete local recordings/photos after the server confirms receipt (keep false for the pilot).
EXPO_PUBLIC_PURGE_MEDIA_AFTER_SYNC=false

# Development only: pretend uploads succeed when no server is configured.
EXPO_PUBLIC_SIMULATE_SYNC=false
